{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "lang",
    "schedule"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "type": {
      "enum": [
        "conference",
        "techblog",
        "preprint",
        "company_paper",
        "journal"
      ]
    },
    "company": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "venue": {
      "type": "string"
    },
    "method": {
      "enum": [
        "rss",
        "arxiv_api",
        "jstage_api",
        "html_list",
        "html_doi_table",
        "html_title_table",
        "sitemap"
      ]
    },
    "feed": {
      "type": "string",
      "pattern": "^https?://"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "filter_hint": {
      "type": "string"
    },
    "lang": {
      "enum": [
        "ja",
        "en"
      ]
    },
    "schedule": {
      "enum": [
        "weekly",
        "monthly",
        "yearly"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "query": {
      "type": "string",
      "description": "arxiv_api / jstage_api の検索クエリ"
    },
    "cdjournal": {
      "type": "string",
      "description": "jstage_api で対象誌を限定するJ-STAGE誌コード(例: pjsai)"
    },
    "openalex_source": {
      "type": "string",
      "description": "html_title_table でDOI解決に使うOpenAlexのsource id(例: S4363608767 = KDD)"
    },
    "openalex_year": {
      "type": "integer",
      "description": "html_title_table でDOI解決する出版年"
    },
    "link_pattern": {
      "type": "string",
      "description": "html_list で記事リンクを拾う正規表現"
    },
    "max_items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  },
  "anyOf": [
    {
      "required": [
        "feed"
      ]
    },
    {
      "required": [
        "url"
      ]
    },
    {
      "required": [
        "query"
      ]
    },
    {
      "required": [
        "cdjournal"
      ]
    }
  ]
}
