{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Article",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "url", "title", "published", "collected", "companies", "source", "evidence", "lang", "summary_ja", "tags", "confidence"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "maxLength": 100},
    "url": {"type": "string", "pattern": "^https?://"},
    "alt_urls": {"type": "array", "items": {"type": "string", "pattern": "^https?://"}, "uniqueItems": true},
    "doi": {"type": "string"},
    "image": {"type": "string", "pattern": "^https?://"},
    "title": {"type": "string", "minLength": 1},
    "title_ja": {"type": "string"},
    "published": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "collected": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "companies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}},
    "collab_academia": {"type": "boolean"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "venue"],
      "properties": {
        "type": {"enum": ["conference", "techblog", "preprint", "company_paper", "journal"]},
        "venue": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {"enum": ["peer_reviewed", "industry_paper", "preprint", "blog"]},
    "lang": {"enum": ["ja", "en"]},
    "summary_ja": {"type": "string", "minLength": 20, "maxLength": 600},
    "problem": {"type": "string", "maxLength": 1000},
    "approach": {"type": "string", "maxLength": 1000},
    "result": {"type": "string", "maxLength": 400},
    "tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task"],
      "properties": {
        "task": {"$ref": "#/$defs/tagList1to3"},
        "domain": {"$ref": "#/$defs/tagList0to3"},
        "method": {"$ref": "#/$defs/tagList0to4"},
        "data_type": {"$ref": "#/$defs/tagList0to3"}
      }
    },
    "has_online_experiment": {"type": "boolean"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "$defs": {
    "tag": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "tagList1to3": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/tag"}},
    "tagList0to3": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/tag"}},
    "tagList0to4": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/tag"}}
  }
}
