---
const { title = "Applied DS Research DB", description = "企業のデータサイエンス/計算機科学の応用事例データベース" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/atom+xml" title="新着" href={`${base}/feed.xml`} />
    <style is:global>
      :root {
        --bg: #fbfbfa; --fg: #1d2125; --muted: #5e6670; --line: #dcdfe3; --card: #fff;
        --accent: #0b5cad; --chip: #eef2f7; --chip-fg: #29405c;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --bg: #14171a; --fg: #e6e8ea; --muted: #9aa3ad; --line: #2c3238; --card: #1b1f23;
          --accent: #6cb2ff; --chip: #262d35; --chip-fg: #c4d4e8;
        }
      }
      * { box-sizing: border-box; }
      body { margin: 0; background: var(--bg); color: var(--fg);
        font: 16px/1.7 system-ui, -apple-system, "Hiragino Sans", "Noto Sans JP", sans-serif; }
      a { color: var(--accent); }
      header.site { border-bottom: 1px solid var(--line); background: var(--card); }
      header.site .in, main, footer .in { max-width: 960px; margin: 0 auto; padding: 0 16px; }
      header.site .in { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; min-height: 56px; }
      header.site .brand { font-weight: 700; color: var(--fg); text-decoration: none; }
      header.site nav { display: flex; gap: 16px; flex-wrap: wrap; }
      main { padding-top: 24px; padding-bottom: 48px; }
      h1 { font-size: 1.6rem; margin: 0 0 8px; } h2 { font-size: 1.2rem; margin: 32px 0 8px; }
      .muted { color: var(--muted); font-size: .9rem; }
      .chip { display: inline-block; background: var(--chip); color: var(--chip-fg); border-radius: 999px;
        padding: 0 10px; margin: 2px 4px 2px 0; font-size: .8rem; text-decoration: none; }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 14px 16px; margin: 12px 0; }
      .card h3 { margin: 0 0 4px; font-size: 1.05rem; } .card p { margin: 6px 0; }
      .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 8px; list-style: none; padding: 0; }
      .grid li { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; }
      dl.meta { display: grid; grid-template-columns: max-content 1fr; gap: 4px 16px; }
      dl.meta dt { color: var(--muted); } dl.meta dd { margin: 0; }
      footer { border-top: 1px solid var(--line); padding: 16px 0; margin-top: 32px; }
      @media (max-width: 600px) { dl.meta { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="in">
        <a class="brand" href={`${base}/`}>Applied DS Research DB</a>
        <nav>
          <a href={`${base}/search/`}>検索</a>
          <a href={`${base}/companies/`}>企業</a>
          <a href={`${base}/tags/`}>タグ</a>
          <a href={`${base}/stats/`}>統計</a>
          <a href={`${base}/feed.xml`}>Atom</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="in muted">
        要約は各記事の内容を独自にまとめたものです。詳細は必ず原典をご確認ください。
        <a href="https://github.com/nigimitama/applied-ds-research-db">GitHub</a>
      </div>
    </footer>
  </body>
</html>
