---
import Base from "../layouts/Base.astro";
import { loadArticles, loadCompanies, loadTaxonomy, AXES } from "../lib/data.mjs";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const articles = loadArticles();
const companies = loadCompanies();
const tax = loadTaxonomy();

// 年別件数
const byYear = {};
for (const a of articles) byYear[a.published.slice(0, 4)] = (byYear[a.published.slice(0, 4)] || 0) + 1;
const years = Object.keys(byYear).sort();
const maxYear = Math.max(1, ...Object.values(byYear));

// 企業 × タスク ヒートマップ(件数上位)
const cCount = {}, tCount = {}, cell = {};
for (const a of articles)
  for (const c of a.companies)
    for (const t of a.tags.task || []) {
      cCount[c] = (cCount[c] || 0) + 1; tCount[t] = (tCount[t] || 0) + 1;
      cell[`${c}|${t}`] = (cell[`${c}|${t}`] || 0) + 1;
    }
const topC = Object.entries(cCount).sort((a, b) => b[1] - a[1]).slice(0, 12).map(([k]) => k);
const topT = Object.entries(tCount).sort((a, b) => b[1] - a[1]).slice(0, 10).map(([k]) => k);
const maxCell = Math.max(1, ...Object.values(cell));
---
<Base title="統計 | Applied DS Research DB">
  <h1>統計</h1>
  {articles.length === 0 && <p class="muted">まだ記事がありません。</p>}
  <h2>年別の事例数</h2>
  <div style="display:flex;gap:8px;align-items:flex-end;height:140px;border-bottom:1px solid var(--line)">
    {years.map((y) => (
      <div style="flex:1;max-width:64px;text-align:center">
        <div class="muted">{byYear[y]}</div>
        <div style={`height:${Math.round((byYear[y] / maxYear) * 100)}px;background:var(--accent);border-radius:4px 4px 0 0`}></div>
      </div>
    ))}
  </div>
  <div style="display:flex;gap:8px">{years.map((y) => <div class="muted" style="flex:1;max-width:64px;text-align:center">{y}</div>)}</div>

  {topC.length > 0 && (<>
    <h2>企業 × タスク</h2>
    <div style="overflow-x:auto">
      <table style="border-collapse:collapse;font-size:.85rem">
        <thead><tr><th></th>{topT.map((t) => <th style="padding:4px 6px;font-weight:600;writing-mode:vertical-rl">{tax.task[t]?.ja ?? t}</th>)}</tr></thead>
        <tbody>
          {topC.map((c) => (
            <tr>
              <th style="text-align:left;padding:4px 8px;white-space:nowrap"><a href={`${base}/company/${c}/`}>{companies[c]?.name_ja ?? companies[c]?.name ?? c}</a></th>
              {topT.map((t) => {
                const n = cell[`${c}|${t}`] || 0;
                return <td style={`text-align:center;min-width:28px;border:1px solid var(--line);background:color-mix(in srgb, var(--accent) ${Math.round((n / maxCell) * 70)}%, transparent)`}>{n || ""}</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </>)}
</Base>
