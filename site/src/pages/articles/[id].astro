---
import Base from "../../layouts/Base.astro";
import { loadArticles, loadCompanies, loadTaxonomy, EVIDENCE_LABEL, SOURCE_LABEL, AXES } from "../../lib/data.mjs";
import { articleTags } from "../../lib/components.mjs";

export function getStaticPaths() {
  return loadArticles().map((a) => ({ params: { id: a.id }, props: { a } }));
}
const { a } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const tax = loadTaxonomy();
const companies = loadCompanies();
const tags = articleTags(a, tax);
const cname = (c) => companies[c]?.name_ja ?? companies[c]?.name ?? c;
---
<Base title={`${a.title_ja ?? a.title} | Applied DS Research DB`} description={a.summary_ja}>
  <article data-pagefind-body>
    <h1 data-pagefind-meta="title">{a.title_ja ?? a.title}</h1>
    {a.title_ja && <p class="muted">{a.title}</p>}

    {a.image && (
      <a href={a.url} rel="noopener noreferrer" target="_blank" class="hero">
        <img src={a.image} alt="" loading="lazy" referrerpolicy="no-referrer" />
      </a>
    )}

    <p>{a.summary_ja}</p>
    {a.problem && (<><h2>課題</h2><p>{a.problem}</p></>)}
    {a.result && (<><h2>報告されている成果</h2><p>{a.result}</p></>)}

    <h2>情報</h2>
    <!-- data-pagefind-filter: 要素のテキストがフィルタ値になる(検索ページのファセット) -->
    <dl class="meta">
      <dt>企業</dt>
      <dd>{a.companies.map((c) => (<a data-pagefind-filter="企業" href={`${base}/company/${c}/`} style="margin-right:.6em">{cname(c)}</a>))}{a.collab_academia ? "(大学等との共同)" : ""}</dd>
      <dt>公開日</dt><dd data-pagefind-meta={`date:${a.published}`}>{a.published}</dd>
      <dt>公開年</dt><dd data-pagefind-filter="年">{a.published.slice(0, 4)}</dd>
      <dt>媒体</dt><dd>{a.source.venue}</dd>
      <dt>種別</dt><dd data-pagefind-filter="種別">{SOURCE_LABEL[a.source.type]}</dd>
      <dt>信頼度区分</dt><dd data-pagefind-filter="信頼度">{EVIDENCE_LABEL[a.evidence]}</dd>
      {a.has_online_experiment && (<><dt>本番検証</dt><dd data-pagefind-filter="本番検証">オンライン実験あり</dd></>)}
      <dt>原典</dt><dd><a href={a.url} rel="noopener noreferrer" target="_blank">{a.url}</a></dd>
    </dl>
    <p>
      {tags.map((t) => (
        <a class="chip" data-pagefind-filter={AXES[t.axis].label} href={`${base}/tag/${t.axis}/${t.id}/`}>{t.label}</a>
      ))}
    </p>
  </article>
</Base>
<style>
  .hero { display: block; max-width: 640px; margin: 12px auto 16px; }
  .hero img { width: 100%; height: auto; border-radius: 8px; border: 1px solid var(--line); display: block; }
</style>
